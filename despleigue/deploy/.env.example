# Estos valores no contienen credenciales. DATABASE_URL y JWT_SECRET viven en Secrets Manager.
AWS_REGION=us-east-1
LAMBDA_FUNCTION_NAME=shelf-inference-dev-inference
LAMBDA_READ_TIMEOUT_SECONDS=70
APP_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:shelf-inference-dev/monolith-EXAMPLE
S3_BUCKET=REEMPLAZAR-CON-OUTPUT-inspections_bucket
SITE_ADDRESS=app.example.com
BACKEND_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/shelf-inference-dev/backend@sha256:REEMPLAZAR
FRONTEND_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/shelf-inference-dev/frontend@sha256:REEMPLAZAR
