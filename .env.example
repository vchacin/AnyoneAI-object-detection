# Credenciales AWS / Neon S3. Copiar a .env y rellenar.
# NUNCA commitear el .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=

# Clave legacy para desarrollo. La autenticación objetivo usa JWT.
API_KEY=

# Configuración objetivo del backend
DATABASE_URL=postgresql://neondb_owner:npg_azDbThw7uLc6@ep-square-resonance-b5iq0lr9-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
EXPERIMENT_REPORT_DIR=./training/reports/inference
MAX_IMAGE_MB=10
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
CORS_ORIGINS=http://localhost:5173
UPLOAD_ROOT=./app/data/uploads
COST_PER_HOUR_USD=
IMAGES_PER_HOUR_CAPACITY=

# Storage backend: local | s3
STORAGE_BACKEND=local
S3_BUCKET=inspections
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-2
S3_ENDPOINT_URL=
PRESIGNED_URL_TTL_SECONDS=900

# Modelos. El manifiesto `modelos/manifest.json` es la fuente de verdad;
# MODEL_NAME solo sobrescribe la clave `active` del manifiesto.
MODEL_MANIFEST=./modelos/manifest.json
MODEL_NAME=yolo26s-b8k_geo3k_e100
# Carpeta donde se resuelven los pesos del manifiesto (Docker: /models)
MODEL_ROOT=
MODEL_PATH=./modelos/best.pt
MODEL_VERSION=
DEFAULT_MODEL=official
SHELFVISION_PRODUCT_WEIGHTS=./modelos/shelfvision/product_best.pt
SHELFVISION_MISSING_WEIGHTS=./modelos/shelfvision/missing_best.pt
SHELFVISION_MODEL_VERSION=manifest-v1

# Ajustes de inferencia (opciones)
INFERENCE_CONF=0.25
DEFAULT_CONF=0.25
GAP_AUTO_SCORE=0.5
# Origen de los huecos: model | heuristic | hybrid
GAP_MODE=model
# Dispositivo de inferencia: cpu | cuda
DEVICE=cpu
