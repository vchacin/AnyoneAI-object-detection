# Credenciales AWS para descargar SKU-110K. Copiar a .env y rellenar.
# NUNCA commitear el .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Clave legacy para desarrollo. La autenticación objetivo usa JWT.
API_KEY=

# Configuración objetivo del backend
DATABASE_URL=sqlite:///./app/data/detections.db
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
PRESIGNED_URL_TTL_SECONDS=900
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
EXPERIMENT_REPORT_DIR=./training/reports/inference
MAX_IMAGE_MB=15
CORS_ORIGINS=http://localhost:5173

# Modelos. El manifiesto `modelos/manifest.json` es la fuente de verdad;
# MODEL_NAME solo sobrescribe la clave `active` del manifiesto.
MODEL_MANIFEST=./modelos/manifest.json
MODEL_NAME=yolo26s-b8k_geo3k_e100
# Carpeta donde se resuelven los pesos del manifiesto (Docker: /models)
MODEL_ROOT=
MODEL_PATH=./modelos/best.pt
MODEL_VERSION=
DEFAULT_MODEL=official
SHELFVISION_PRODUCT_WEIGHTS=./modelos/shelfvision/product_best.pt
SHELFVISION_MISSING_WEIGHTS=./modelos/shelfvision/missing_best.pt
SHELFVISION_MODEL_VERSION=manifest-v1

# Ajustes de inferencia (opcionales)
INFERENCE_CONF=0.25
DEFAULT_CONF=0.25
GAP_AUTO_SCORE=0.5
# Origen de los huecos: model | heuristic | hybrid
GAP_MODE=model
# Dispositivo de inferencia: cpu | cuda
DEVICE=cpu
